# DEV environment: run the service on your machine without Docker for the app: npm run start:dev
# (it loads this file). Safe to commit: the passwords are the throw-away ones of the local compose database.
# The values are the defaults of the code (src/config/app-config.ts), except DATABASE_URL, REDIS_URL and the
# two switches at the end, which assume the Postgres and Redis of `docker compose up -d postgres redis`
# (host ports 5433 and 6380). Under Docker Compose this file is not used: docker-compose.yml sets its own values.
#
# One file per environment, named .env.<name>. Only dev exists for now; a new one is a copy of this file plus
# a script "start:<name>" in package.json. .env.* files other than this one are git-ignored (secrets).

# --- Connections (required) ---
PORT=3000
DATABASE_URL=postgresql://weather:weather@localhost:5433/weather?schema=public
REDIS_URL=redis://localhost:6380/0

# --- Weather refresh ---
# Refresh a city from Open-Meteo at most once per this many hours
FORECAST_TTL_HOURS=6
# While another request refreshes a city: check every LOCK_POLL_MS, give up after LOCK_WAIT_MS;
# LOCK_TTL_MS is how long the refresh lock lives if its holder crashes
LOCK_POLL_MS=500
LOCK_WAIT_MS=10000
LOCK_TTL_MS=30000

# --- Limits ---
# Per client (x-api-key header, else IP): this many requests per window
CLIENT_RATE_LIMIT=60
CLIENT_RATE_WINDOW_SECONDS=60
# Pause calling Open-Meteo this long after it answers 429 without a retry time
UPSTREAM_PAUSE_MINUTES=15

# --- Open-Meteo (change only to point at a mock or a paid plan) ---
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# OPEN_METEO_TIMEOUT_MS=8000

# --- Things for exploring by hand: OFF by default, turned on here for local work ---
# Apollo Sandbox page at /graphql + schema introspection
GRAPHQL_SANDBOX=true
# Optional test web page at /ui (not part of the assignment)
UI_ENABLED=true
