# Copy to .env for local (non-Docker) runs. Docker Compose sets its own values.
PORT=3000
DATABASE_URL=postgresql://weather:weather@localhost:5432/weather?schema=public
REDIS_URL=redis://localhost:6379/0

# Refresh a location at most once per this many hours
FORECAST_TTL_HOURS=6
# Per-client limit: requests per window
CLIENT_RATE_LIMIT=60
CLIENT_RATE_WINDOW_SECONDS=60
# Pause calling Open-Meteo for this long after it answers 429 without a retry time
UPSTREAM_PAUSE_MINUTES=15
# Keep at most this many locations; the least recently requested is removed first
MAX_STORED_LOCATIONS=1000
